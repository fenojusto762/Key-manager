# =============================================================================
# KEY MANAGER — variáveis de ambiente
# Copie para .env (local) ou cadastre no painel da Vercel. NUNCA faça commit do .env.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
# URL do projeto
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable". Usada só para validar login.
SUPABASE_ANON_KEY=
# Chave SECRETA: "service_role" (legada) ou "secret". Somente no servidor!
# Jamais coloque esta chave no frontend, em repositórios públicos ou em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ----------------------------------------------------------------
# Domínio técnico usado para mapear "usuário" -> e-mail interno do Supabase Auth
# (ex.: joao -> joao@keymanager.app). Nenhum e-mail é enviado. Não altere depois de criar usuários.
AUTH_EMAIL_DOMAIN=keymanager.app
# Fuso usado nos gráficos diários
APP_TIMEZONE=America/Sao_Paulo
NODE_ENV=development
PORT=3000

# --- Proteção contra abuso (requisições por janela, por IP) --------------------
VALIDATE_RATE_LIMIT_PER_MIN=60
LOGIN_RATE_LIMIT_PER_15MIN=10
API_RATE_LIMIT_PER_15MIN=600
GENERATE_RATE_LIMIT_PER_MIN=20

# --- Somente para `npm run create-admin` (opcional; se vazio, o script pergunta) ---
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
